<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Saphir.App"
             Name="SAPHIR"
             RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://SAPHIR.App/Styles/Windows7.axaml" />
    </Application.Styles>

    <Application.Resources>
        <!-- Police : Segoe UI sous Windows, police système ailleurs. -->
        <FontFamily x:Key="WindowsFont">Segoe UI, Helvetica Neue, Roboto, Arial</FontFamily>

        <!-- Couleurs Windows 7 -->
        <SolidColorBrush x:Key="AccentBrush" Color="#3399FF"/>
        <SolidColorBrush x:Key="SelectionBrush" Color="#CCE8FF"/>
        <SolidColorBrush x:Key="SelectionBorderBrush" Color="#7DA2CE"/>
        <SolidColorBrush x:Key="TitleTextBrush" Color="#1E395B"/>
        <SolidColorBrush x:Key="LinkBrush" Color="#0066CC"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#A0A0A0"/>
        <SolidColorBrush x:Key="InstructionBrush" Color="#003399"/>

        <!-- Cadre Aero : verre bleuté (fenêtre active / inactive) -->
        <LinearGradientBrush x:Key="AeroActiveBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#F2C4DCF4"/>
            <GradientStop Offset="0.35" Color="#EBA9C8EC"/>
            <GradientStop Offset="1" Color="#E693B8E2"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AeroInactiveBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#F2E3ECF6"/>
            <GradientStop Offset="1" Color="#EBCFDCEB"/>
        </LinearGradientBrush>

        <!-- Barre des tâches vitrée -->
        <LinearGradientBrush x:Key="TaskbarBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#B8536E92"/>
            <GradientStop Offset="0.5" Color="#D02A4366"/>
            <GradientStop Offset="1" Color="#E0152742"/>
        </LinearGradientBrush>

        <!-- Menu Démarrer : colonne de droite -->
        <LinearGradientBrush x:Key="StartRightBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#E63D5A80"/>
            <GradientStop Offset="1" Color="#F01C3354"/>
        </LinearGradientBrush>

        <!-- Bouton Windows 7 -->
        <LinearGradientBrush x:Key="ButtonBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#F2F2F2"/>
            <GradientStop Offset="0.5" Color="#EBEBEB"/>
            <GradientStop Offset="0.5" Color="#DDDDDD"/>
            <GradientStop Offset="1" Color="#CFCFCF"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ButtonHoverBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#EAF6FD"/>
            <GradientStop Offset="0.5" Color="#D9F0FC"/>
            <GradientStop Offset="0.5" Color="#BEE6FD"/>
            <GradientStop Offset="1" Color="#A7D9F5"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ButtonPressedBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#E5F4FC"/>
            <GradientStop Offset="0.5" Color="#C4E5F6"/>
            <GradientStop Offset="0.5" Color="#98D1EF"/>
            <GradientStop Offset="1" Color="#68B3DB"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CloseButtonBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#E8A493"/>
            <GradientStop Offset="0.45" Color="#D9705A"/>
            <GradientStop Offset="0.5" Color="#C7503B"/>
            <GradientStop Offset="1" Color="#C4472F"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#FFFFFF"/>
            <GradientStop Offset="1" Color="#E8EEF6"/>
        </LinearGradientBrush>

        <!-- Icônes vectorielles (24 × 24) -->
        <StreamGeometry x:Key="IconWindows">M0,0H11V11H0Z M13,0H24V11H13Z M0,13H11V24H0Z M13,13H24V24H13Z</StreamGeometry>
        <StreamGeometry x:Key="IconSearch">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</StreamGeometry>
