<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Saphir.Views.Apps.Operations.PgFicheView">
    <!-- DataContext : PgFicheSection. Fiche d'intervention (7.1) : synthèse, équipages, chronologie, compte rendu (7.3), suites. -->
    <Grid RowDefinitions="Auto,Auto,*">
        <Border Background="#F7FAFD" BorderBrush="#C8D5E7" BorderThickness="0,0,0,1" Padding="12,6">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Entete}" FontSize="13" Foreground="Black" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Classes="muted" Text="{Binding Lieu}"/>
                    <TextBlock Classes="muted" Text="{Binding Cloture}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                    <Button Classes="small" Content="GÉOOPS" Command="{Binding GeoopsCommand}"/>
                    <Button Classes="small" Content="Actualiser" Command="{Binding ActualiserCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" IsVisible="{Binding ASecurite}" Background="#FDECEA" BorderBrush="#E7B4A9" BorderThickness="0,0,0,1" Padding="12,5">
            <TextBlock Text="{Binding AlerteSecurite}" TextWrapping="Wrap" FontSize="12" Foreground="#9B1C12" FontWeight="SemiBold"/>
        </Border>

        <TabControl Grid.Row="2" Classes="win7" Margin="10,8,10,10">
            <!-- ===== Synthèse ===== -->
            <TabItem Header="Synthèse">
                <ScrollViewer>
                    <StackPanel Margin="12,10" Spacing="8">
                        <TextBlock FontSize="12" Foreground="Black" TextWrapping="Wrap" Text="{Binding Requerant, StringFormat='Requérant : {0}'}"/>
                        <TextBlock Classes="muted" Text="{Binding Demandes}"/>
                        <TextBlock Classes="muted" Text="{Binding Securite}"/>
                        <TextBlock Classes="muted" Text="{Binding Intervention.Description}" FontSize="12"/>

                        <TextBlock Classes="groupheader" Text="Appels liés"/>
                        <ItemsControl ItemsSource="{Binding Appels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                                        <Button Classes="link" Content="{Binding Numero}" Command="{Binding $parent[UserControl].DataContext.OuvrirAppelCommand}" CommandParameter="{Binding}"/>
                                        <TextBlock Classes="muted" Text="{Binding Recu}" VerticalAlignment="Center"/>
                                        <TextBlock Classes="muted" Text="{Binding Canal}" VerticalAlignment="Center"/>
                                        <TextBlock Classes="muted" Text="{Binding Operateur}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Classes="groupheader" Text="Personnes concernées"/>
                        <TextBlock Classes="muted" Text="Aucune personne signalée." IsVisible="{Binding AucunePersonne}"/>
                        <ItemsControl ItemsSource="{Binding Personnes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Foreground="Black" Margin="0,1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Classes="groupheader" Text="Véhicules concernés"/>
                        <TextBlock Classes="muted" Text="Aucun véhicule signalé." IsVisible="{Binding AucunVehicule}"/>
                        <ItemsControl ItemsSource="{Binding Vehicules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Foreground="Black" Margin="0,1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Qualification (8.4 : priorité modifiée avec justification) -->
                        <StackPanel Spacing="6" IsVisible="{Binding PeutQualifier}" Margin="0,8,0,0">
                            <TextBlock Classes="groupheader" Text="Qualification"/>
                            <WrapPanel>
                                <StackPanel Width="210" Margin="0,0,10,6">
                                    <TextBlock Classes="label" Text="Motif"/>
                                    <ComboBox ItemsSource="{Binding Motifs}" SelectedItem="{Binding Nature}" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                                <StackPanel Width="200" Margin="0,0,10,6">
                                    <TextBlock Classes="label" Text="Sous-motif"/>
                                    <TextBox Text="{Binding SousMotif}"/>
                                </StackPanel>
                                <StackPanel Width="80" Margin="0,0,10,6">
                                    <TextBlock Classes="label" Text="Priorité"/>
                                    <ComboBox ItemsSource="{Binding Priorites}" SelectedItem="{Binding Priorite}" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                                <StackPanel Width="280" Margin="0,0,10,6">
                                    <TextBlock Classes="label" Text="Justification (changement de priorité)"/>
                                    <TextBox Text="{Binding Justification}"/>
                                </StackPanel>
                                <StackPanel Width="280" Margin="0,0,10,6">
                                    <TextBlock Classes="label" Text="Adresse"/>
                                    <TextBox Text="{Binding Adresse}"/>
                                </StackPanel>
                                <StackPanel Width="160" Margin="0,0,10,6">
                                    <TextBlock Classes="label" Text="Commune"/>
                                    <TextBox Text="{Binding Commune}"/>
                                </StackPanel>
                                <StackPanel Width="80" Margin="0,0,10,6">
                                    <TextBlock Classes="label" Text="Code postal"/>
                                    <TextBox Text="{Binding CodePostal}"/>
                                </StackPanel>
                                <StackPanel Width="90" Margin="0,0,10,6">
                                    <TextBlock Classes="label" Text="X"/>
                                    <TextBox Text="{Binding PosX}"/>
                                </StackPanel>
                                <StackPanel Width="90" Margin="0,0,10,6">
                                    <TextBlock Classes="label" Text="Y"/>
                                    <TextBox Text="{Binding PosY}"/>
                                </StackPanel>
                                <StackPanel Width="120" Margin="0,0,10,6">
                                    <TextBlock Classes="label" Text="Équipages demandés"/>
                                    <TextBox Text="{Binding EquipagesDemandes}"/>
                                </StackPanel>
                                <StackPanel Width="180" Margin="0,0,10,6">
                                    <TextBlock Classes="label" Text="Catégorie de moyen"/>
                                    <ComboBox ItemsSource="{Binding CategoriesMoyen}" SelectedItem="{Binding CategorieMoyen}" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Classes="label" Text="Description"/>
                            <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50"/>
                            <Button Content="Enregistrer la qualification" Command="{Binding QualifierCommand}" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- Statut global (7.2) -->
                        <Border IsVisible="{Binding PeutChangerStatutIntervention}" Background="#F4F8FC" BorderBrush="#D5DFE9" BorderThickness="1" Padding="10,8" Margin="0,8,0,0">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="groupheader" Text="Statut de l'intervention"/>
                                <WrapPanel>
                                    <ComboBox ItemsSource="{Binding Statuts}" SelectedItem="{Binding NouveauStatut}" Width="200" Margin="0,0,6,6"/>
                                    <TextBox Text="{Binding MotifStatut}" Watermark="Motif (obligatoire pour annuler, ou clôturer sans compte rendu)" Width="380" Margin="0,0,6,6"/>
                                    <Button Classes="default" Content="Appliquer" Command="{Binding StatutCommand}" Margin="0,0,0,6"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Équipages ===== -->
            <TabItem Header="Équipages">
                <Grid RowDefinitions="*,Auto" Margin="10">
                    <DataGrid ItemsSource="{Binding Engagements}" SelectedItem="{Binding EngagementChoisi}" AutoGenerateColumns="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Équipage" Binding="{Binding Indicatif}" Width="110"/>
                            <DataGridTextColumn Header="Statut" Binding="{Binding Statut}" Width="140"/>
                            <DataGridTextColumn Header="Chef de bord" Binding="{Binding Chef}" Width="150"/>
                            <DataGridTextColumn Header="Agents" Binding="{Binding Agents}" Width="*"/>
                            <DataGridTextColumn Header="Véhicule" Binding="{Binding Vehicule}" Width="150"/>
                            <DataGridTextColumn Header="Affecté" Binding="{Binding Affecte}" Width="60"/>
                            <DataGridTextColumn Header="En route" Binding="{Binding EnRoute}" Width="65"/>
                            <DataGridTextColumn Header="Sur place" Binding="{Binding SurPlace}" Width="70"/>
                            <DataGridTextColumn Header="Fin" Binding="{Binding Termine}" Width="55"/>
                            <DataGridTextColumn Header="Affecté par" Binding="{Binding AffectePar}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Spacing="6" Margin="0,8,0,0">
                        <WrapPanel IsVisible="{Binding PeutChangerStatutEquipage}">
                            <TextBlock Classes="label" Text="Équipage sélectionné :" VerticalAlignment="Center" Margin="0,0,6,6"/>
                            <ComboBox ItemsSource="{Binding StatutsEquipage}" SelectedItem="{Binding StatutEquipage}" Width="190" Margin="0,0,6,6"/>
                            <TextBox Text="{Binding MotifEquipage}" Watermark="Précision / motif" Width="220" Margin="0,0,6,6"/>
                            <Button Classes="default" Content="Changer le statut" Command="{Binding StatutEquipageCommand}" Margin="0,0,6,6"/>
                            <Button Content="Désengager" Command="{Binding DesengagerCommand}" IsVisible="{Binding PeutAffecter}" Margin="0,0,6,6"/>
                        </WrapPanel>
                        <WrapPanel IsVisible="{Binding PeutAffecter}">
                            <TextBlock Classes="label" Text="Engager :" VerticalAlignment="Center" Margin="0,0,6,6"/>
                            <ComboBox ItemsSource="{Binding EquipagesDisponibles}" SelectedItem="{Binding EquipageAEngager}" Width="320" Margin="0,0,6,6"
                                      PlaceholderText="Aucun équipage disponible">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding Indicatif, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text="{Binding Type, Mode=OneWay, StringFormat=' — {0}'}"/>
                                            <Run Text="{Binding Statut, Mode=OneWay, StringFormat=' ({0})'}" Foreground="#2E8B3E"/>
                                            <Run Text="{Binding Chef, Mode=OneWay, StringFormat=' — {0}'}" Foreground="#5B6B7C"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <CheckBox Content="Renfort" IsChecked="{Binding Renfort}" Margin="0,0,6,6"/>
                            <Button Content="Affecter l'équipage" Command="{Binding EngagerCommand}" Margin="0,0,0,6"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===== Chronologie et communications ===== -->
            <TabItem Header="Chronologie">
                <Grid RowDefinitions="*,Auto" Margin="10">
                    <DataGrid ItemsSource="{Binding Chronologie}" AutoGenerateColumns="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Heure" Binding="{Binding Heure}" Width="120"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120"/>
                            <DataGridTextColumn Header="Texte" Binding="{Binding Texte}" Width="*"/>
                            <DataGridTextColumn Header="Auteur" Binding="{Binding Auteur}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,8,0,0" IsVisible="{Binding PeutEcrire}">
                        <TextBox Text="{Binding Message}" Watermark="Message horodaté sur l'intervention"/>
                        <Button Grid.Column="1" Classes="default" Content="Envoyer" Command="{Binding MessageCommand}" Margin="8,0,0,0"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ===== Compte rendu ===== -->
            <TabItem Header="Compte rendu">
                <ScrollViewer>
                    <StackPanel Margin="12,10" Spacing="8">
                        <WrapPanel>
                            <TextBlock Classes="label" Text="Comptes rendus :" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <ItemsControl ItemsSource="{Binding ComptesRendus}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Classes="small" Margin="0,0,6,6" Command="{Binding $parent[UserControl].DataContext.OuvrirCrCommand}" CommandParameter="{Binding}">
                                            <TextBlock>
                                                <Run Text="{Binding Indicatif, Mode=OneWay, TargetNullValue='Équipage ?'}"/>
                                                <Run Text="{Binding Statut, Mode=OneWay, StringFormat=' — {0}'}"/>
                                            </TextBlock>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Classes="small" Content="Nouveau compte rendu" Command="{Binding NouveauCrCommand}" IsVisible="{Binding PeutRediger}" Margin="0,0,0,6"/>
                        </WrapPanel>
                        <TextBlock Classes="muted" Text="{Binding EtatCompteRendu}"/>

                        <StackPanel Spacing="8" IsEnabled="{Binding PeutModifierCr}">
                            <WrapPanel>
                                <StackPanel Width="230" Margin="0,0,10,6">
                                    <TextBlock Classes="label" Text="Équipage"/>
                                    <ComboBox ItemsSource="{Binding Engagements}" SelectedItem="{Binding CrEquipage}" HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Libelle}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Width="230" Margin="0,0,10,6">
                                    <TextBlock Classes="label" Text="Chef de bord"/>
                                    <TextBox Text="{Binding CrEdition.ChefDeBord}"/>
                                </StackPanel>
                                <StackPanel Width="140" Margin="0,0,10,6">
                                    <TextBlock Classes="label" Text="Heure d'arrivée"/>
                                    <TextBox Text="{Binding CrEdition.Arrivee}" Watermark="jj/mm/aaaa hh:mm"/>
                                </StackPanel>
                                <StackPanel Width="140" Margin="0,0,10,6">
                                    <TextBlock Classes="label" Text="Heure de départ"/>
                                    <TextBox Text="{Binding CrEdition.Depart}"/>
                                </StackPanel>
                                <StackPanel Width="140" Margin="0,0,10,6">
                                    <TextBlock Classes="label" Text="Heure de fin"/>
                                    <TextBox Text="{Binding CrEdition.Fin}"/>
                                </StackPanel>
                                <StackPanel Width="230" Margin="0,0,10,6">
                                    <TextBlock Classes="label" Text="Résultat"/>
                                    <ComboBox ItemsSource="{Binding Resultats}" SelectedItem="{Binding CrEdition.Resultat}" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Classes="label" Text="Faits constatés"/>
                            <TextBox Text="{Binding CrEdition.Faits}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"/>
                            <WrapPanel>
                                <StackPanel Width="300" Margin="0,0,10,6">
                                    <TextBlock Classes="label" Text="Mesures prises"/>
                                    <TextBox Text="{Binding CrEdition.Mesures}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44"/>
                                </StackPanel>
                                <StackPanel Width="300" Margin="0,0,10,6">
                                    <TextBlock Classes="label" Text="Personnes contrôlées"/>
                                    <TextBox Text="{Binding CrEdition.PersonnesControlees}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44"/>
                                </StackPanel>
                                <StackPanel Width="300" Margin="0,0,10,6">
                                    <TextBlock Classes="label" Text="Interpellations signalées"/>
                                    <TextBox Text="{Binding CrEdition.Interpellations}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44"/>
                                </StackPanel>
                                <StackPanel Width="300" Margin="0,0,10,6">
                                    <TextBlock Classes="label" Text="Victimes prises en charge"/>
                                    <TextBox Text="{Binding CrEdition.Victimes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44"/>
                                </StackPanel>
                                <StackPanel Width="300" Margin="0,0,10,6">
                                    <TextBlock Classes="label" Text="Véhicules"/>
                                    <TextBox Text="{Binding CrEdition.Vehicules}"/>
                                </StackPanel>
                                <StackPanel Width="300" Margin="0,0,10,6">
                                    <TextBlock Classes="label" Text="Secours"/>
                                    <TextBox Text="{Binding CrEdition.Secours}"/>
                                </StackPanel>
                                <StackPanel Width="300" Margin="0,0,10,6">
                                    <TextBlock Classes="label" Text="Transport"/>
                                    <TextBox Text="{Binding CrEdition.Transport}"/>
                                </StackPanel>
                                <StackPanel Width="300" Margin="0,0,10,6">
                                    <TextBlock Classes="label" Text="Destination"/>
                                    <TextBox Text="{Binding CrEdition.Destination}"/>
                                </StackPanel>
                                <StackPanel Width="300" Margin="0,0,10,6">
                                    <TextBlock Classes="label" Text="Documents"/>
                                    <TextBox Text="{Binding CrEdition.Documents}"/>
                                </StackPanel>
                            </WrapPanel>
                            <CheckBox Content="Suite judiciaire nécessaire" IsChecked="{Binding CrEdition.SuiteJudiciaire}"/>
                            <TextBlock Classes="label" Text="Observations"/>
                            <TextBox Text="{Binding CrEdition.Observations}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40"/>
                            <Button Content="Enregistrer le compte rendu" Command="{Binding EnregistrerCrCommand}" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <Button Classes="default" Content="Valider le compte rendu" Command="{Binding ValiderCrCommand}" IsVisible="{Binding PeutValiderCr}" HorizontalAlignment="Left"/>
                        <Border IsVisible="{Binding CrValide}" Background="#EEF7EF" BorderBrush="#A9D3B0" BorderThickness="1" Padding="10,8">
                            <WrapPanel>
                                <TextBlock Text="Compte rendu validé :" FontSize="12" Foreground="Black" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <Button Content="Proposer une mention de main courante" Command="{Binding ProjetMentionCommand}" IsVisible="{Binding PeutProposerMention}" Margin="0,0,8,4"/>
                                <Button Content="Ouvrir une procédure LRPPN" Command="{Binding OuvrirLrppnCommand}" IsVisible="{Binding PeutOuvrirLrppn}" Margin="0,0,8,4"/>
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Suites et références ===== -->
            <TabItem Header="Suites">
                <ScrollViewer>
                    <StackPanel Margin="12,10" Spacing="8">
                        <TextBlock FontSize="12" Foreground="Black" Text="{Binding SuiteJudiciaire}"/>
                        <WrapPanel>
                            <Button Content="Créer une mention de main courante" Command="{Binding ProjetMentionCommand}" IsVisible="{Binding PeutProposerMention}" Margin="0,0,8,6"/>
                            <Button Content="Ouvrir une procédure LRPPN" Command="{Binding OuvrirLrppnCommand}" IsVisible="{Binding PeutOuvrirLrppn}" Margin="0,0,8,6"/>
                        </WrapPanel>
                        <TextBlock Classes="muted" Text="Les informations reprises dans la mention ou la procédure doivent être vérifiées par le rédacteur."/>

                        <TextBlock Classes="groupheader" Text="Mentions de main courante liées"/>
                        <ItemsControl ItemsSource="{Binding Mentions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                                        <Button Classes="link" Content="{Binding Numero}" Command="{Binding $parent[UserControl].DataContext.OuvrirMentionCommand}" CommandParameter="{Binding}"/>
                                        <TextBlock Classes="muted" Text="{Binding Type}" VerticalAlignment="Center"/>
                                        <TextBlock Classes="muted" Text="{Binding Statut}" VerticalAlignment="Center"/>
                                        <TextBlock Classes="muted" Text="{Binding Redacteur}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Spacing="6" IsEnabled="{Binding PeutReferences}">
                            <TextBlock Classes="groupheader" Text="Références"/>
                            <WrapPanel>
                                <StackPanel Width="220" Margin="0,0,10,6">
                                    <TextBlock Classes="label" Text="Procédure LRPPN"/>
                                    <TextBox Text="{Binding ProcedureLrppn}"/>
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Classes="label" Text="Suites"/>
                            <TextBox Text="{Binding Suites}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44"/>
                            <TextBlock Classes="label" Text="Documents"/>
                            <TextBox Text="{Binding Documents}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44"/>
                            <Button Content="Enregistrer les références" Command="{Binding ReferencesCommand}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
