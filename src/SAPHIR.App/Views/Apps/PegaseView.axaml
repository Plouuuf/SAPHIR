<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Saphir.Views.Apps.PegaseView"
             Background="#F3F5F8"
             Foreground="#1F2937">
    <!-- PEGASE : prise d'appels 17, événements et équipages. DataContext : PegaseViewModel. -->
    <UserControl.Styles>
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button.tabbtn">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Foreground" Value="#1F2937"/>
        </Style>
        <Style Selector="Button.tabbtn:pointerover /template/ Border#Root">
            <Setter Property="Background" Value="#D5DEEA"/>
        </Style>
        <Style Selector="Button.tabbtn.selected /template/ Border#Root">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#1E4FA0"/>
            <Setter Property="BorderThickness" Value="0,0,0,3"/>
        </Style>
        <Style Selector="Border.block">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#9DB3D1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style Selector="TextBlock.blocktitle">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0B2A5B"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.pill TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- ===================== En-tête ===================== -->
        <Border Background="#0B2A5B" Padding="14,9">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Image Source="avares://SAPHIR.App/Assets/saphir-icon.png" Width="30" Height="30" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="PEGASE" Foreground="White" FontWeight="Bold" FontSize="15"/>
                    <TextBlock Text="{Binding Summary}" Foreground="#B8C7E0" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="60" IsVisible="{Binding IsBusy}" Foreground="#76B9ED"/>
                    <Button Classes="secondary small" Content="Actualiser" Command="{Binding RefreshCommand}"/>
                    <Button Classes="primary" Content="Nouvel appel 17" Command="{Binding NewCallCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Onglets ===================== -->
        <Border Grid.Row="1" Background="#E7ECF3" BorderBrush="#D3DBE6" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <Button Classes="flat tabbtn" Classes.selected="{Binding IsEventsTab}" Command="{Binding ShowEventsCommand}">
                        <TextBlock Text="Événements" FontWeight="SemiBold"/>
                    </Button>
                    <Button Classes="flat tabbtn" Classes.selected="{Binding IsCrewsTab}" Command="{Binding ShowCrewsCommand}">
                        <TextBlock Text="Équipages" FontWeight="SemiBold"/>
                    </Button>
                    <Button Classes="flat tabbtn" Classes.selected="{Binding IsCallsTab}" Command="{Binding ShowCallsCommand}">
                        <TextBlock Text="{Binding CallsTabLabel}" FontWeight="SemiBold"/>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ===================== Messages ===================== -->
        <Border Grid.Row="2" Background="#FDECEC" BorderBrush="#C62828" BorderThickness="0,0,0,2" Padding="16,8"
                IsVisible="{Binding HasError}">
            <TextBlock Text="{Binding ErrorText}" Foreground="#8E1C1C" TextWrapping="Wrap"/>
        </Border>
        <Border Grid.Row="3" Background="#E8F5E9" BorderBrush="#2E7D32" BorderThickness="0,0,0,2" Padding="16,8"
                IsVisible="{Binding HasInfo}">
            <TextBlock Text="{Binding InfoText}" Foreground="#1B5E20" TextWrapping="Wrap"/>
        </Border>

        <!-- ===================== Onglet Événements ===================== -->
        <Grid Name="EventsGrid" Grid.Row="4" ColumnDefinitions="360,*" IsVisible="{Binding IsEventsTab}">

            <Border Name="EventListPane" Background="White" BorderBrush="#D3DBE6" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*">
                    <CheckBox Content="Afficher les événements terminés (12 h)" IsChecked="{Binding ShowClosed}" Margin="12,8" FontSize="12"/>
                    <TextBlock Grid.Row="1" Classes="muted" Margin="14,4" IsVisible="{Binding HasNoEvents}"
                               Text="Aucun événement en cours. Les appels 17 décrochés sur SIMCALL ouvrent la prise d'appel automatiquement."/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="5,*" Margin="-4,0,0,0">
                                    <Border Background="{Binding PrioriteBrush}" CornerRadius="2"/>
                                    <StackPanel Grid.Column="1" Margin="10,2,0,2" Spacing="2">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Text="{Binding Priorite}" FontWeight="Bold" Foreground="{Binding PrioriteBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Numero}" Classes="muted" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Heure}" Classes="muted" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Nature}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Lieu}" FontSize="12" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Classes="pill" Background="{Binding StatutBrush}">
                                                <TextBlock Text="{Binding Statut}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Equipages}" Classes="muted" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Name="EventDetailPane" Grid.Column="1">
                <StackPanel IsVisible="{Binding ShowNoSelection}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <Image Source="avares://SAPHIR.App/Assets/saphir-icon.png" Width="90" Height="90" Opacity="0.85"/>
                    <TextBlock Classes="muted" Text="Sélectionne un événement pour voir sa fiche." TextAlignment="Center"/>
                </StackPanel>

                <ScrollViewer IsVisible="{Binding HasDetail}">
                    <StackPanel Margin="20,14,20,24" Spacing="12">
                        <Button Name="BackButton" Classes="link" Content="← Événements" Command="{Binding BackCommand}" IsVisible="False"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Classes="pill" Background="{Binding DetailPriorityBrush}">
                                        <TextBlock Text="{Binding DetailPriority}"/>
                                    </Border>
                                    <Border Classes="pill" Background="{Binding DetailStatusBrush}">
                                        <TextBlock Text="{Binding DetailStatus}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Classes="h1" Text="{Binding DetailTitle}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top"
                                        IsVisible="{Binding CanEditDetail}">
                                <Button Classes="secondary small" Content="Modifier" Command="{Binding EditEventCommand}"/>
                                <Button Classes="danger" Content="Clore l'événement" Command="{Binding StartCloseCommand}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Modification -->
                        <Border Classes="card" IsVisible="{Binding IsEditingEvent}">
                            <StackPanel Spacing="10" DataContext="{Binding EventForm}">
                                <TextBlock Classes="h2" Text="Modifier l'événement"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,8,8" Spacing="3"><TextBlock Classes="label" Text="Nature *"/>
                                        <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.Natures}" SelectedItem="{Binding Nature}"/></StackPanel>
                                    <StackPanel Margin="0,0,0,8" Spacing="3"><TextBlock Classes="label" Text="Priorité"/>
                                        <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.Priorites}" SelectedIndex="{Binding PrioriteIndex}"/></StackPanel>
                                    <StackPanel Margin="0,0,8,8" Spacing="3"><TextBlock Classes="label" Text="Adresse *"/><TextBox Text="{Binding Adresse}"/></StackPanel>
                                    <StackPanel Margin="0,0,0,8" Spacing="3"><TextBlock Classes="label" Text="Commune"/><TextBox Text="{Binding Commune}"/></StackPanel>
                                    <StackPanel Margin="0,0,8,8" Spacing="3"><TextBlock Classes="label" Text="Requérant"/><TextBox Text="{Binding RequerantNom}"/></StackPanel>
                                    <StackPanel Margin="0,0,0,8" Spacing="3"><TextBlock Classes="label" Text="Téléphone"/><TextBox Text="{Binding RequerantTel}"/></StackPanel>
                                </UniformGrid>
                                <StackPanel Spacing="3"><TextBlock Classes="label" Text="Complément (étage, digicode, repère)"/><TextBox Text="{Binding Complement}"/></StackPanel>
                                <StackPanel Spacing="3"><TextBlock Classes="label" Text="Description"/>
                                    <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"/></StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="primary" Content="Enregistrer" Command="{Binding $parent[UserControl].DataContext.SaveEventCommand}"/>
                                    <Button Classes="secondary" Content="Annuler" Command="{Binding $parent[UserControl].DataContext.CancelEditCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Clôture -->
                        <Border Classes="card" IsVisible="{Binding IsClosingEvent}">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="h2" Text="Clore l'événement"/>
                                <TextBlock Classes="muted" Text="Les équipages engagés repassent disponibles."/>
                                <TextBox Text="{Binding CloseReport}" Watermark="Compte rendu (suite donnée, interpellations, procédure…)"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="primary" Content="Clore" Command="{Binding ConfirmCloseCommand}"/>
                                    <Button Classes="secondary" Content="Annuler" Command="{Binding CancelEditCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <ItemsControl ItemsSource="{Binding DetailRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="130,*" Margin="0,3">
                                            <TextBlock Classes="label" Text="{Binding Label}"/>
                                            <TextBlock Grid.Column="1" Classes="value" Text="{Binding Value}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- Équipages engagés -->
                        <TextBlock Classes="h2" Text="Équipages engagés"/>
                        <TextBlock Classes="muted" Text="Aucun équipage engagé." IsVisible="{Binding !HasEngagedCrews}"/>
                        <ItemsControl ItemsSource="{Binding EngagedCrews}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="card" Margin="0,0,0,6" Padding="12,8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Indicatif}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Type}" Classes="muted" VerticalAlignment="Center"/>
                                                <Border Classes="pill" Background="{Binding StatutBrush}">
                                                    <TextBlock Text="{Binding Statut}"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                        IsVisible="{Binding $parent[UserControl].DataContext.DetailOpen}">
                                                <Button Classes="secondary small" Content="Sur place" Command="{Binding SetStatusCommand}" CommandParameter="Sur place"/>
                                                <Button Classes="secondary small" Content="Libérer" Command="{Binding SetStatusCommand}" CommandParameter="Disponible"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding DetailOpen}">
                            <ComboBox ItemsSource="{Binding EngageableCrews}" SelectedItem="{Binding CrewToEngage}"
                                      PlaceholderText="Aucun équipage disponible">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding Indicatif}" FontWeight="Bold"/>
                                            <Run Text=" — "/>
                                            <Run Text="{Binding Statut}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Classes="primary" Content="Engager" Margin="8,0,0,0" Command="{Binding EngageCommand}"/>
                        </Grid>

                        <!-- Chronologie -->
                        <TextBlock Classes="h2" Text="Chronologie" Margin="0,6,0,0"/>
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="3,Auto,*" Margin="0,0,0,6">
                                        <Border Background="{Binding Accent}"/>
                                        <StackPanel Grid.Column="1" Margin="8,0,10,0" Width="110">
                                            <TextBlock Text="{Binding Heure}" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Text="{Binding Auteur}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Texte}" Classes="value"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding DetailOpen}">
                            <TextBox Text="{Binding NewMessage}" Watermark="Ajouter un message à la chronologie">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding AddMessageCommand}"/>
                                </TextBox.KeyBindings>
                            </TextBox>
                            <Button Grid.Column="1" Classes="secondary" Content="Ajouter" Margin="8,0,0,0" Command="{Binding AddMessageCommand}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ===================== Onglet Équipages ===================== -->
        <ScrollViewer Grid.Row="4" IsVisible="{Binding IsCrewsTab}">
            <StackPanel Margin="20,14,20,24" Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="h1" Text="Équipages"/>
                    <Button Grid.Column="1" Classes="primary small" Content="Nouvel équipage" Command="{Binding NewCrewCommand}" VerticalAlignment="Center"/>
                </Grid>

                <Border Classes="card" IsVisible="{Binding IsCrewFormOpen}">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="h2" Text="{Binding CrewFormTitle}"/>
                        <UniformGrid Columns="2" DataContext="{Binding CrewForm}">
                            <StackPanel Margin="0,0,8,8" Spacing="3"><TextBlock Classes="label" Text="Indicatif * (ex. PS 94-1, BAC N 94)"/><TextBox Text="{Binding Indicatif}"/></StackPanel>
                            <StackPanel Margin="0,0,0,8" Spacing="3"><TextBlock Classes="label" Text="Type *"/>
                                <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.TypesEquipage}" SelectedItem="{Binding Type}"/></StackPanel>
                        </UniformGrid>
                        <StackPanel Spacing="3" DataContext="{Binding CrewForm}"><TextBlock Classes="label" Text="Effectif (agents, véhicule)"/><TextBox Text="{Binding Effectif}"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="primary" Content="Enregistrer" Command="{Binding SaveCrewCommand}"/>
                            <Button Classes="secondary" Content="Annuler" Command="{Binding CancelCrewCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Classes="muted" Text="Aucun équipage. Crée les équipages de la vacation (indicatif, type, effectif)." IsVisible="{Binding HasNoCrews}"/>
                <ItemsControl ItemsSource="{Binding Crews}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="card" Margin="0,0,0,8">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Indicatif}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                            <Border Classes="pill" Background="{Binding StatutBrush}">
                                                <TextBlock Text="{Binding Statut}"/>
                                            </Border>
                                            <Button Classes="link" Content="{Binding Mission}" IsVisible="{Binding IsOnEvent}"
                                                    Command="{Binding OpenEventCommand}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <Button Classes="secondary small" Content="Modifier" Command="{Binding EditCommand}"/>
                                            <Button Classes="danger" Content="Supprimer" Command="{Binding DeleteCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Classes="muted">
                                        <Run Text="{Binding Type}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Effectif}"/>
                                    </TextBlock>
                                    <WrapPanel>
                                        <Button Classes="secondary small" Content="Disponible" Margin="0,0,6,0" Command="{Binding SetStatusCommand}" CommandParameter="Disponible"/>
                                        <Button Classes="secondary small" Content="Sur place" Margin="0,0,6,0" Command="{Binding SetStatusCommand}" CommandParameter="Sur place"
                                                IsVisible="{Binding IsOnEvent}"/>
                                        <Button Classes="secondary small" Content="Indisponible" Margin="0,0,6,0" Command="{Binding SetStatusCommand}" CommandParameter="Indisponible"/>
                                        <Button Classes="secondary small" Content="Hors service" Command="{Binding SetStatusCommand}" CommandParameter="Hors service"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ===================== Onglet Appels en attente ===================== -->
        <ScrollViewer Grid.Row="4" IsVisible="{Binding IsCallsTab}">
            <StackPanel Margin="20,14,20,24" Spacing="10">
                <TextBlock Classes="h1" Text="Appels en attente"/>
                <TextBlock Classes="muted" Text="Appels décrochés pas encore qualifiés (2 dernières heures)." />
                <TextBlock Classes="muted" Text="Aucun appel en attente." IsVisible="{Binding !HasPendingCalls}"/>
                <ItemsControl ItemsSource="{Binding PendingCalls}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="card" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Titre}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Detail}" Classes="muted"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="primary small" Content="Reprendre" Command="{Binding ResumeCommand}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ===================== Prise d'appel (au-dessus de tout) ===================== -->
        <Border Grid.Row="4" Background="#DCE6F2" IsVisible="{Binding IsCallOpen}">
            <ScrollViewer>
                <StackPanel Margin="16,12,16,20" Spacing="10" MaxWidth="980">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding CallTitle}" FontSize="18" FontWeight="Bold" Foreground="#0B2A5B" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Classes="pill" Background="#C62828" IsVisible="{Binding CallOnLine}">
                            <TextBlock Text="EN LIGNE"/>
                        </Border>
                    </Grid>

                    <Border Classes="block">
                        <StackPanel>
                            <TextBlock Classes="blocktitle" Text="Informations téléphoniques"/>
                            <UniformGrid Columns="3">
                                <StackPanel Margin="0,0,10,8" Spacing="2"><TextBlock Classes="label" Text="Décroché le"/><TextBlock Text="{Binding CallAnsweredAt}" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Margin="0,0,10,8" Spacing="2"><TextBlock Classes="label" Text="Durée de l'appel"/>
                                    <Border Background="#2E7D32" CornerRadius="2" Padding="8,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding CallDuration}" Foreground="White" FontWeight="Bold" FontFamily="Consolas, Menlo, monospace"/>
                                    </Border></StackPanel>
                                <StackPanel Margin="0,0,0,8" Spacing="2"><TextBlock Classes="label" Text="Opérateur"/><TextBlock Text="{Binding CallOperator}" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Margin="0,0,10,0" Spacing="2"><TextBlock Classes="label" Text="Numéro du requérant"/><TextBlock Text="{Binding CallNumber}" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Margin="0,0,10,0" Spacing="2"><TextBlock Classes="label" Text="Origine"/><TextBlock Text="{Binding CallSource}" FontWeight="SemiBold"/></StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="10" DataContext="{Binding CallForm}">
                        <Border Classes="block">
                            <StackPanel>
                                <TextBlock Classes="blocktitle" Text="Localisation de l'événement"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,8,8" Spacing="3"><TextBlock Classes="label" Text="Adresse *"/><TextBox Text="{Binding Adresse}"/></StackPanel>
                                    <StackPanel Margin="0,0,0,8" Spacing="3"><TextBlock Classes="label" Text="Commune"/><TextBox Text="{Binding Commune}"/></StackPanel>
                                </UniformGrid>
                                <StackPanel Spacing="3"><TextBlock Classes="label" Text="Complément (étage, digicode, repère)"/><TextBox Text="{Binding Complement}"/></StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="block">
                            <StackPanel>
                                <TextBlock Classes="blocktitle" Text="Qualification"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,8,0" Spacing="3"><TextBlock Classes="label" Text="Nature de l'événement *"/>
                                        <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.Natures}" SelectedItem="{Binding Nature}"
                                                  PlaceholderText="Choisir…"/></StackPanel>
                                    <StackPanel Spacing="3"><TextBlock Classes="label" Text="Priorité"/>
                                        <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.Priorites}" SelectedIndex="{Binding PrioriteIndex}"/></StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Classes="block">
                            <StackPanel>
                                <TextBlock Classes="blocktitle" Text="Requérant"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,8,0" Spacing="3"><TextBlock Classes="label" Text="Nom, prénom"/><TextBox Text="{Binding RequerantNom}"/></StackPanel>
                                    <StackPanel Spacing="3"><TextBlock Classes="label" Text="Téléphone de rappel"/><TextBox Text="{Binding RequerantTel}"/></StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Classes="block">
                            <StackPanel>
                                <TextBlock Classes="blocktitle" Text="Motif de l'appel"/>
                                <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110"
                                         Background="#FFFBE6" Watermark="Ce que décrit le requérant : faits, individus, véhicules, sens de fuite, armes…"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <WrapPanel>
                        <Button Classes="primary" Content="Créer l'événement" Margin="0,0,8,8" Command="{Binding CreateEventCommand}"/>
                        <Button Classes="secondary" Content="Clore sans suite" Margin="0,0,8,8" Command="{Binding ToggleSansSuiteCommand}"/>
                        <Button Classes="secondary" Content="Mettre en attente" Margin="0,0,8,8" Command="{Binding HideCallCommand}"/>
                    </WrapPanel>

                    <Border Classes="block" IsVisible="{Binding IsSansSuiteOpen}">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="blocktitle" Text="Clôture sans événement"/>
                            <ComboBox ItemsSource="{Binding MotifsSansSuite}" SelectedItem="{Binding SansSuiteMotif}"/>
                            <TextBox Text="{Binding SansSuiteObservations}" Watermark="Observations (facultatif)"/>
                            <Button Classes="danger" Content="Confirmer la clôture" Command="{Binding ConfirmSansSuiteCommand}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
