<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Saphir.Views.Apps.Rh.RhDossierView">
    <!-- 3. Dossier individuel (4.5). DataContext : RhDossierViewModel. Formulaires : modèles définis dans RhView. -->
    <UserControl.Styles>
        <Style Selector="Border.cadre">
            <Setter Property="BorderBrush" Value="#C8D5E7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F7FAFD"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>
        <Style Selector="TextBlock.valeur">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style Selector="TextBlock.cle">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#5B6B7C"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">
        <WrapPanel Margin="0,0,0,6">
            <TextBlock Classes="label" Text="Agent :" VerticalAlignment="Center" Margin="0,0,8,6"/>
            <ComboBox ItemsSource="{Binding AgentsChoix}" SelectedItem="{Binding AgentChoisi}" DisplayMemberBinding="{Binding Libelle}"
                      Width="340" PlaceholderText="Choisir un agent…" Margin="0,0,8,6"/>
            <Button Classes="small" Content="Actualiser" Command="{Binding ActualiserCommand}" Margin="0,0,8,6"/>
        </WrapPanel>

        <TextBlock Grid.Row="1" Classes="muted" Text="Choisis un agent dans la liste, ou ouvre son dossier depuis la gestion du personnel."
                   IsVisible="{Binding !HasDossier}" TextWrapping="Wrap"/>

        <Border Grid.Row="1" IsVisible="{Binding HasDossier}" Background="#EEF4FB" BorderBrush="#C8D5E7" BorderThickness="1" Padding="10,6" Margin="0,0,0,6">
            <WrapPanel>
                <PathIcon Data="{StaticResource IconUser}" Width="22" Height="22" Foreground="#1E395B" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Entete}" FontSize="14" FontWeight="SemiBold" Foreground="#1E395B" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Border Background="White" BorderBrush="#A9C7EA" BorderThickness="1" CornerRadius="2" Padding="6,1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatutActuel}" FontSize="11.5"/>
                </Border>
            </WrapPanel>
        </Border>

        <TabControl Grid.Row="2" Classes="win7" SelectedIndex="{Binding Onglet}" IsVisible="{Binding HasDossier}">
            <!-- ===== Identité ===== -->
            <TabItem Header="Identité">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel Margin="10">
                        <Border Classes="cadre" Width="360">
                            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                <TextBlock Grid.ColumnSpan="2" Classes="groupheader" Text="Fiche administrative"/>
                                <TextBlock Grid.Row="1" Classes="cle" Text="Identifiant SAPHIR"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Classes="valeur" Text="{Binding Agent.Reference}"/>
                                <TextBlock Grid.Row="2" Classes="cle" Text="Identifiant Discord"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Classes="valeur" Text="{Binding Agent.DiscordId}"/>
                                <TextBlock Grid.Row="3" Classes="cle" Text="NOM"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Classes="valeur" Text="{Binding Agent.Nom}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="4" Classes="cle" Text="Prénom"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Classes="valeur" Text="{Binding Agent.Prenom}"/>
                                <TextBlock Grid.Row="5" Classes="cle" Text="RIO"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Classes="valeur" Text="{Binding RioActuel}"/>
                                <TextBlock Grid.Row="6" Classes="cle" Text="Matricule"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Classes="valeur" Text="{Binding MatriculeActuel}"/>
                                <TextBlock Grid.Row="7" Classes="cle" Text="Grade"/>
                                <TextBlock Grid.Row="7" Grid.Column="1" Classes="valeur" Text="{Binding GradeActuel}"/>
                                <TextBlock Grid.Row="8" Classes="cle" Text="Service"/>
                                <TextBlock Grid.Row="8" Grid.Column="1" Classes="valeur" Text="{Binding AffectationService}"/>
                                <TextBlock Grid.Row="9" Classes="cle" Text="Unité"/>
                                <TextBlock Grid.Row="9" Grid.Column="1" Classes="valeur" Text="{Binding AffectationUnite}"/>
                                <TextBlock Grid.Row="10" Classes="cle" Text="Fonction"/>
                                <TextBlock Grid.Row="10" Grid.Column="1" Classes="valeur" Text="{Binding AffectationFonction}"/>
                                <TextBlock Grid.Row="11" Classes="cle" Text="Statut administratif"/>
                                <TextBlock Grid.Row="11" Grid.Column="1" Classes="valeur" Text="{Binding StatutActuel}"/>
                                <TextBlock Grid.Row="12" Classes="cle" Text="Date d'intégration"/>
                                <TextBlock Grid.Row="12" Grid.Column="1" Classes="valeur" Text="{Binding DateIntegration}"/>
                                <TextBlock Grid.Row="13" Classes="cle" Text="Dernière connexion"/>
                                <TextBlock Grid.Row="13" Grid.Column="1" Classes="valeur" Text="{Binding DerniereConnexion}"/>
                                <TextBlock Grid.Row="14" Classes="cle" Text="Date de modification"/>
                                <TextBlock Grid.Row="14" Grid.Column="1" Classes="valeur" Text="{Binding MajLe}"/>
                            </Grid>
                        </Border>
                        <StackPanel Width="380" Spacing="10">
                            <Border Classes="cadre" Margin="0"><ContentControl Content="{Binding Identite}"/></Border>
                            <Border Classes="cadre" Margin="0"><ContentControl Content="{Binding Matricule}"/></Border>
                            <Border Classes="cadre" Margin="0" IsVisible="{Binding Integration.Autorise}"><ContentControl Content="{Binding Integration}"/></Border>
                            <Border Classes="cadre" Margin="0"><ContentControl Content="{Binding Statut}"/></Border>
                        </StackPanel>
                        <Border Classes="cadre" Width="750" Margin="0,10,10,10">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="groupheader" Text="Modifications d'identité"/>
                                <DataGrid ItemsSource="{Binding Identites}" IsReadOnly="True" AutoGenerateColumns="False" Height="130"
                                          GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Effet" Binding="{Binding Effet}" Width="85"/>
                                        <DataGridTextColumn Header="Ancienne identité" Binding="{Binding Ancienne}" Width="150"/>
                                        <DataGridTextColumn Header="Nouvelle identité" Binding="{Binding Nouvelle}" Width="150"/>
                                        <DataGridTextColumn Header="Motif" Binding="{Binding Motif}" Width="*"/>
                                        <DataGridTextColumn Header="Par" Binding="{Binding Auteur}" Width="140"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Affectation ===== -->
            <TabItem Header="Affectation">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel Margin="10">
                        <Border Classes="cadre" Width="340">
                            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                                <TextBlock Grid.ColumnSpan="2" Classes="groupheader" Text="Affectation actuelle"/>
                                <TextBlock Grid.Row="1" Classes="cle" Text="Service"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Classes="valeur" Text="{Binding AffectationService}"/>
                                <TextBlock Grid.Row="2" Classes="cle" Text="Unité"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Classes="valeur" Text="{Binding AffectationUnite}"/>
                                <TextBlock Grid.Row="3" Classes="cle" Text="Fonction"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Classes="valeur" Text="{Binding AffectationFonction}"/>
                                <TextBlock Grid.Row="4" Classes="cle" Text="Responsable"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Classes="valeur" Text="{Binding AffectationResponsable}"/>
                                <TextBlock Grid.Row="5" Classes="cle" Text="Depuis le"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Classes="valeur" Text="{Binding AffectationDebut}"/>
                            </Grid>
                        </Border>
                        <Border Classes="cadre" Width="400"><ContentControl Content="{Binding Affectation}"/></Border>
                        <Border Classes="cadre" Width="750">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="groupheader" Text="Historique des affectations"/>
                                <DataGrid ItemsSource="{Binding Affectations}" IsReadOnly="True" AutoGenerateColumns="False" Height="180"
                                          GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Début" Binding="{Binding Debut}" Width="85"/>
                                        <DataGridTextColumn Header="Fin" Binding="{Binding Fin}" Width="85"/>
                                        <DataGridTextColumn Header="Service" Binding="{Binding Service}" Width="110"/>
                                        <DataGridTextColumn Header="Unité" Binding="{Binding Unite}" Width="90"/>
                                        <DataGridTextColumn Header="Fonction" Binding="{Binding Fonction}" Width="120"/>
                                        <DataGridTextColumn Header="Responsable" Binding="{Binding Responsable}" Width="120"/>
                                        <DataGridTextColumn Header="Motif" Binding="{Binding Motif}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Grade ===== -->
            <TabItem Header="Grade">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel Margin="10">
                        <Border Classes="cadre" Width="300">
                            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto">
                                <TextBlock Grid.ColumnSpan="2" Classes="groupheader" Text="Grade actuel"/>
                                <TextBlock Grid.Row="1" Classes="cle" Text="Grade"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Classes="valeur" Text="{Binding GradeActuel}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="2" Classes="cle" Text="Date d'effet"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Classes="valeur" Text="{Binding GradeEffet}"/>
                            </Grid>
                        </Border>
                        <Border Classes="cadre" Width="420"><ContentControl Content="{Binding Grade}"/></Border>
                        <Border Classes="cadre" Width="750">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="groupheader" Text="Historique des grades (carrière)"/>
                                <DataGrid ItemsSource="{Binding Carriere}" IsReadOnly="True" AutoGenerateColumns="False" Height="180"
                                          GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Effet" Binding="{Binding Effet}" Width="85"/>
                                        <DataGridTextColumn Header="Ancien grade" Binding="{Binding Ancien}" Width="130"/>
                                        <DataGridTextColumn Header="Nouveau grade" Binding="{Binding Nouveau}" Width="130"/>
                                        <DataGridTextColumn Header="Motif" Binding="{Binding Motif}" Width="*"/>
                                        <DataGridTextColumn Header="Par" Binding="{Binding Auteur}" Width="140"/>
                                        <DataGridTextColumn Header="Saisi le" Binding="{Binding Saisi}" Width="115"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== RIO ===== -->
            <TabItem Header="RIO">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel Margin="10">
                        <Border Classes="cadre" Width="440"><ContentControl Content="{Binding Rio}"/></Border>
                        <Border Classes="cadre" Width="750">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="groupheader" Text="Anciens RIO"/>
                                <DataGrid ItemsSource="{Binding RioHistorique}" IsReadOnly="True" AutoGenerateColumns="False" Height="160"
                                          GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Effet" Binding="{Binding Effet}" Width="85"/>
                                        <DataGridTextColumn Header="Ancien RIO" Binding="{Binding Ancien}" Width="95"/>
                                        <DataGridTextColumn Header="Nouveau RIO" Binding="{Binding Nouveau}" Width="95"/>
                                        <DataGridTextColumn Header="Motif" Binding="{Binding Motif}" Width="*"/>
                                        <DataGridTextColumn Header="Par" Binding="{Binding Auteur}" Width="140"/>
                                        <DataGridTextColumn Header="Saisi le" Binding="{Binding Saisi}" Width="115"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Documents ===== -->
            <TabItem Header="Documents">
                <Grid RowDefinitions="Auto,*" Margin="10">
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="Ouvrir dans Documents" Command="{Binding DocumentsCommand}" Margin="0,0,6,0"/>
                        <Button Content="Générer depuis un modèle…" Command="{Binding GenererCommand}" IsVisible="{Binding PeutGenerer}" Margin="0,0,6,0"/>
                        <Button Content="Télécharger" Command="{Binding TelechargerCommand}" IsEnabled="{Binding HasDocument}"/>
                    </WrapPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Documents}" SelectedItem="{Binding Document}" IsReadOnly="True"
                              AutoGenerateColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Référence" Binding="{Binding Reference}" Width="105"/>
                            <DataGridTextColumn Header="Document" Binding="{Binding Titre}" Width="*"/>
                            <DataGridTextColumn Header="Catégorie" Binding="{Binding Categorie}" Width="150"/>
                            <DataGridTextColumn Header="Statut" Binding="{Binding Statut}" Width="85"/>
                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="60"/>
                            <DataGridTextColumn Header="Modifié le" Binding="{Binding MajLe}" Width="115"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ===== Habilitations ===== -->
            <TabItem Header="Habilitations">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10" Spacing="8">
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="Rôles Discord : le rôle SAPHIR (WL) est obligatoire et vérifié à chaque connexion ; le rôle RH est vérifié à chaque appel du module RH. Les permissions internes ci-dessous viennent des profils de l'agent."/>
                        <WrapPanel>
                            <Border Classes="cadre" Width="260">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="groupheader" Text="Profils"/>
                                    <ItemsControl ItemsSource="{Binding Profils}"/>
                                </StackPanel>
                            </Border>
                            <Border Classes="cadre" Width="300">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="groupheader" Text="Applications accessibles"/>
                                    <ItemsControl ItemsSource="{Binding Applications}"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                        <Button Content="Gérer les profils dans Administration" Command="{Binding AdministrationCommand}"
                                IsVisible="{Binding PeutOuvrirAdministration}" HorizontalAlignment="Left"/>
                        <TextBlock Classes="groupheader" Text="Permissions internes"/>
                        <DataGrid ItemsSource="{Binding PermissionsAgent}" IsReadOnly="True" AutoGenerateColumns="False" Height="200"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Module" Binding="{Binding Module}" Width="150"/>
                                <DataGridTextColumn Header="Permission" Binding="{Binding Libelle}" Width="*"/>
                                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="200"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Classes="groupheader" Text="Historique des changements de droits"/>
                        <DataGrid ItemsSource="{Binding HistoriqueDroits}" IsReadOnly="True" AutoGenerateColumns="False" Height="150"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="115"/>
                                <DataGridTextColumn Header="Auteur" Binding="{Binding Auteur}" Width="150"/>
                                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="150"/>
                                <DataGridTextColumn Header="Détail" Binding="{Binding Detail}" Width="*"/>
                                <DataGridTextColumn Header="Motif" Binding="{Binding Motif}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Historique ===== -->
            <TabItem Header="Historique">
                <DataGrid ItemsSource="{Binding Historique}" IsReadOnly="True" AutoGenerateColumns="False" Margin="10"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" CanUserResizeColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="115"/>
                        <DataGridTextColumn Header="Auteur" Binding="{Binding Auteur}" Width="150"/>
                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="150"/>
                        <DataGridTextColumn Header="Détail" Binding="{Binding Detail}" Width="*"/>
                        <DataGridTextColumn Header="Motif" Binding="{Binding Motif}" Width="170"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
