<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Saphir.Views.Apps.Rh.RhHabilitationsView">
    <!-- 13. Habilitations (lecture). DataContext : RhHabilitationsViewModel. Modification : application Administration. -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="8">
            <WrapPanel>
                <TextBlock Classes="label" Text="Agent :" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <ComboBox ItemsSource="{Binding AgentsChoix}" SelectedItem="{Binding Agent}" DisplayMemberBinding="{Binding Libelle}"
                          Width="340" PlaceholderText="Choisir un agent…" Margin="0,0,8,4"/>
                <Button Classes="link" Content="Ouvrir son dossier" Command="{Binding OuvrirDossierCommand}" IsVisible="{Binding Charge}"
                        VerticalAlignment="Center" Margin="0,0,10,4"/>
                <Button Content="Gérer les profils dans Administration" Command="{Binding Rh.OuvrirAdministrationCommand}"
                        IsVisible="{Binding Rh.PeutOuvrirAdministration}" Margin="0,0,0,4"/>
            </WrapPanel>
            <Border Background="#E8F2FC" BorderBrush="#A9C7EA" BorderThickness="1" Padding="10,6">
                <TextBlock Text="{Binding RolesDiscord}" TextWrapping="Wrap" FontSize="11.5"/>
            </Border>
            <StackPanel Spacing="8" IsVisible="{Binding Charge}">
                <WrapPanel>
                    <Border BorderBrush="#C8D5E7" BorderThickness="1" Background="#F7FAFD" Padding="12,8" Width="260" Margin="0,0,10,0">
                        <StackPanel Spacing="3">
                            <TextBlock Classes="groupheader" Text="Profils internes"/>
                            <ItemsControl ItemsSource="{Binding Profils}"/>
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="#C8D5E7" BorderThickness="1" Background="#F7FAFD" Padding="12,8" Width="320">
                        <StackPanel Spacing="3">
                            <TextBlock Classes="groupheader" Text="Applications accessibles"/>
                            <ItemsControl ItemsSource="{Binding Applications}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
                <TextBlock Classes="groupheader" Text="Permissions internes"/>
                <DataGrid ItemsSource="{Binding PermissionsAgent}" IsReadOnly="True" AutoGenerateColumns="False" Height="230"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Module" Binding="{Binding Module}" Width="150"/>
                        <DataGridTextColumn Header="Permission" Binding="{Binding Libelle}" Width="*"/>
                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="210"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Classes="groupheader" Text="Historique des changements de droits"/>
                <DataGrid ItemsSource="{Binding HistoriqueDroits}" IsReadOnly="True" AutoGenerateColumns="False" Height="160"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="115"/>
                        <DataGridTextColumn Header="Auteur" Binding="{Binding Auteur}" Width="150"/>
                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="160"/>
                        <DataGridTextColumn Header="Détail" Binding="{Binding Detail}" Width="*"/>
                        <DataGridTextColumn Header="Motif" Binding="{Binding Motif}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
