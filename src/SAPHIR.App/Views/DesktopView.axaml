<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Saphir.Views.DesktopView">
    <!-- Bureau Windows 7 : icônes, fenêtres, bulles de notification, menu Démarrer et barre des tâches vitrée. -->
    <UserControl.Styles>
        <Style Selector="TextBlock.iconlabel">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxLines" Value="2"/>
            <Setter Property="Effect">
                <DropShadowEffect BlurRadius="3" OffsetX="1" OffsetY="1" Opacity="1" Color="Black"/>
            </Setter>
        </Style>
        <Style Selector="TextBlock.white">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="PathIcon.offline">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>
        <!-- Orbe Démarrer -->
        <Style Selector="Button.orb">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="4,0,6,0"/>
        </Style>
        <Style Selector="Button.orb Ellipse#Glow">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Button.orb:pointerover Ellipse#Glow">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.orb.active Ellipse#Glow">
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,40">

        <!-- ===================== Zone de travail ===================== -->
        <Panel Name="WorkArea" Grid.RowSpan="2">
            <Image Source="{Binding Wallpaper}" Stretch="UniformToFill"/>
        </Panel>
        <Panel Name="WorkLayer">
            <!-- Fond cliquable : ferme le menu Démarrer, désélectionne ; clic droit = menu contextuel. -->
            <Border Name="Backdrop" Background="Transparent">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Actualiser" Command="{Binding RefreshCommand}">
                            <MenuItem.Icon>
                                <PathIcon Data="{StaticResource IconRefresh}" Width="14" Height="14"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Centre de paramètres" Command="{Binding OpenSettingsCommand}">
                            <MenuItem.Icon>
                                <PathIcon Data="{StaticResource IconSettings}" Width="14" Height="14"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Administration" Command="{Binding OpenAdministrationCommand}" IsVisible="{Binding CanAdminister}"/>
                        <Separator/>
                        <MenuItem Header="Verrouiller la session" Command="{Binding LockCommand}">
                            <MenuItem.Icon>
                                <PathIcon Data="{StaticResource IconLock}" Width="14" Height="14"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
            </Border>

            <!-- Icônes du bureau, en colonnes depuis le coin supérieur gauche. -->
            <ItemsControl Name="DesktopIcons" ItemsSource="{Binding Apps}" Margin="4,6,0,0"
                          HorizontalAlignment="Left" VerticalAlignment="Top">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="desktopicon" Classes.selected="{Binding IsSelected}"
                                Width="84" Height="86" Margin="2" ToolTip.Tip="{Binding Subtitle}">
                            <StackPanel Spacing="3" Margin="2,5,2,0">
                                <Image Source="{Binding Icon}" Width="48" Height="48"
                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                <TextBlock Classes="iconlabel" Text="{Binding Title}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Fenêtres ouvertes (gérées par le code de la vue). -->
            <Canvas Name="WindowLayer"/>

            <!-- Bulles de notification, au-dessus de la zone de notification. -->
            <ItemsControl ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Margin="0,0,10,8" Width="330">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="6" BorderBrush="#767676" BorderThickness="1" Padding="12,10,8,12"
                                BoxShadow="0 4 14 0 #59000000">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                    <GradientStop Offset="0" Color="#FFFFFF"/>
                                    <GradientStop Offset="1" Color="#E4E5F0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                <Panel Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Top">
                                    <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}"/>
                                    <PathIcon Data="{StaticResource IconInfo}" Foreground="#2F6FBF" Width="18" Height="18"
                                              IsVisible="{Binding !HasIcon}"/>
                                </Panel>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="Bold" FontSize="12"
                                           Foreground="Black" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Classes="flat" Width="18" Height="18" Command="{Binding DismissCommand}"
                                        ToolTip.Tip="Fermer" VerticalAlignment="Top">
                                    <Path Data="{StaticResource CaptionClose}" Stroke="#555555" StrokeThickness="1.2" Width="8" Height="8"
                                          Stretch="Uniform"/>
                                </Button>
                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Text}" FontSize="12"
                                           Foreground="#1E1E1E" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===================== Menu Démarrer ===================== -->
            <Border IsVisible="{Binding IsStartMenuOpen}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Width="470" Height="500" MaxHeight="{Binding #WorkLayer.Bounds.Height}"
                    CornerRadius="7,7,0,0" Padding="6,6,6,0" Background="{StaticResource StartRightBrush}"
                    BorderBrush="#80FFFFFF" BorderThickness="1,1,1,0" BoxShadow="0 0 18 0 #80000000">
                <Grid ColumnDefinitions="262,*" RowDefinitions="*,46">

                    <!-- Colonne de gauche : programmes -->
                    <Border CornerRadius="4" Background="White" BorderBrush="#5E7DA5" BorderThickness="1">
                        <DockPanel>
                            <Border DockPanel.Dock="Bottom" BorderBrush="#D6E5F5" BorderThickness="0,1,0,0" Padding="4">
                                <Button Classes="flat startitem" Command="{Binding ToggleAllProgramsCommand}"
                                        IsVisible="{Binding HasOtherPrograms}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconTriangleRight}" Width="10" Height="10" Foreground="#1E395B"/>
                                        <TextBlock Text="{Binding AllProgramsLabel}" FontSize="12" Foreground="Black"/>
                                    </StackPanel>
                                </Button>
                            </Border>
                            <ScrollViewer Padding="0,6">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding StartMain}" IsVisible="{Binding !IsAllProgramsOpen}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Classes="flat startitem" Command="{Binding OpenCommand}">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <Image Source="{Binding Icon}" Width="32" Height="32"
                                                               RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontSize="12" Foreground="Black"/>
                                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#6D6D6D"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Aucun module ne t'est encore attribué. Le service RH ou un administrateur te donnera tes profils."
                                               FontSize="11.5" Foreground="#6D6D6D" TextWrapping="Wrap" Margin="12,6"
                                               IsVisible="{Binding !HasMainPrograms}"/>
                                    <ItemsControl ItemsSource="{Binding StartOther}" IsVisible="{Binding IsAllProgramsOpen}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Classes="flat startitem" Command="{Binding OpenCommand}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Image Source="{Binding Icon}" Width="20" Height="20"
                                                               RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                                        <TextBlock Text="{Binding Title}" FontSize="12" Foreground="Black" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- Colonne de droite : agent connecté et liens -->
                    <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="2">
                        <Border Width="64" Height="64" CornerRadius="5" Padding="4" HorizontalAlignment="Center" Margin="0,4,0,8"
                                BorderBrush="#B3FFFFFF" BorderThickness="1" Background="#40FFFFFF">
                            <Border CornerRadius="3" ClipToBounds="True" Background="#E8F1FA">
                                <Panel>
                                    <Image Source="avares://SAPHIR.App/Assets/saphir-icon.png" Margin="4" IsVisible="{Binding !HasAvatar}"/>
                                    <Image Source="{Binding Avatar}" Stretch="UniformToFill" IsVisible="{Binding HasAvatar}"/>
                                </Panel>
                            </Border>
                        </Border>
                        <TextBlock Classes="white" Text="{Binding AgentName}" FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="10,0"/>
                        <TextBlock Text="{Binding AgentLine}" Foreground="#C9DDF5" FontSize="11" TextWrapping="Wrap" Margin="10,0,10,8"/>
                        <Button Classes="flat startlink" Content="Centre de paramètres" Command="{Binding OpenSettingsCommand}"/>
                        <Button Classes="flat startlink" Content="Administration" Command="{Binding OpenAdministrationCommand}"
                                IsVisible="{Binding CanAdminister}"/>
                        <Border Height="1" Background="#40FFFFFF" Margin="10,6"/>
                        <Button Classes="flat startlink" Content="Verrouiller" Command="{Binding LockCommand}"/>
                    </StackPanel>

                    <!-- Bas : recherche et fermeture de session -->
                    <TextBox Grid.Row="1" Text="{Binding SearchText}" Watermark="Rechercher les programmes"
                             VerticalAlignment="Center" Margin="0,0,0,0" CornerRadius="2"/>
                    <Button Grid.Row="1" Grid.Column="1" Classes="flat" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Height="26" Padding="12,0" CornerRadius="3" Command="{Binding SignOutCommand}"
                            BorderBrush="#80FFFFFF" BorderThickness="1" Background="#26FFFFFF">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="white" Text="Fermer la session" FontSize="12" VerticalAlignment="Center"/>
                            <PathIcon Data="{StaticResource IconSignOut}" Width="12" Height="12" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Panel>

        <!-- ===================== Barre des tâches ===================== -->
        <Border Grid.Row="1" Background="{StaticResource TaskbarBrush}" BorderBrush="#66FFFFFF" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Orbe Démarrer -->
                <Button Classes="flat orb" Classes.active="{Binding IsStartMenuOpen}"
                        Command="{Binding ToggleStartMenuCommand}" ToolTip.Tip="Démarrer">
                    <Panel Width="38" Height="38">
                        <Ellipse Name="Glow" Width="38" Height="38">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Offset="0" Color="#AA9FE0FF"/>
                                    <GradientStop Offset="1" Color="#009FE0FF"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Image Source="avares://SAPHIR.App/Assets/saphir-icon.png" Width="34" Height="34"
                               RenderOptions.BitmapInterpolationMode="HighQuality"/>
                    </Panel>
                </Button>

                <!-- Fenêtres ouvertes (icônes, comme la barre des tâches de Windows 7) -->
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Windows}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Classes="flat taskbar open" Classes.active="{Binding IsActive}"
                                    Command="{Binding TaskbarCommand}" ToolTip.Tip="{Binding Title}">
                                <Image Source="{Binding Icon}" Width="28" Height="28"
                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Zone de notification -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Classes="white" Text="{Binding Version}" FontSize="11" Opacity="0.75" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Classes="flat tray" ToolTip.Tip="{Binding AgentName}" Command="{Binding OpenSettingsCommand}">
                        <PathIcon Data="{StaticResource IconUser}" Width="15" Height="15" Foreground="White"/>
                    </Button>
                    <Button Classes="flat tray" ToolTip.Tip="Centre de maintenance">
                        <PathIcon Data="{StaticResource IconFlag}" Width="15" Height="15" Foreground="White"/>
                    </Button>
                    <Button Classes="flat tray" ToolTip.Tip="{Binding NetworkTooltip}">
                        <PathIcon Data="{StaticResource IconNetwork}" Width="16" Height="16" Foreground="White"
                                  Classes.offline="{Binding !IsOnline}"/>
                    </Button>
                    <Button Classes="flat tray" ToolTip.Tip="Haut-parleurs">
                        <PathIcon Data="{StaticResource IconSpeaker}" Width="16" Height="16" Foreground="White"/>
                    </Button>
                    <Button Classes="flat tray" Padding="8,0" ToolTip.Tip="{Binding LongDate}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Classes="white" Text="{Binding TrayTime}" FontSize="12" HorizontalAlignment="Center"/>
                            <TextBlock Classes="white" Text="{Binding TrayDate}" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- « Afficher le Bureau » : bouton vitré à l'extrême droite -->
                    <Button Classes="flat tray" Width="14" Padding="0" Margin="4,0,0,0" BorderThickness="1,0,0,0"
                            BorderBrush="#80FFFFFF" Background="#14FFFFFF" Command="{Binding ShowDesktopCommand}"
                            ToolTip.Tip="Afficher le Bureau"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
