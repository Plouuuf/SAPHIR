<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Saphir.Views"
             x:Class="Saphir.Views.ShellView"
             FontFamily="{StaticResource WindowsFont}"
             Background="Black"
             Focusable="True">
    <!-- Racine : fond d'ouverture de session (Windows 7) ou bureau, puis l'écran courant. -->
    <Grid ClipToBounds="True">
        <Image Source="{Binding LogonBackground}" Stretch="UniformToFill" IsVisible="{Binding ShowLogonBackground}"/>

        <!-- Contenu, à l'intérieur des zones sûres (encoche, barre d'accueil) sur téléphone et tablette. -->
        <Panel Name="SafeArea">
            <views:LogonView IsVisible="{Binding IsLogonScreen}"/>
            <views:FirstLoginView IsVisible="{Binding IsFirstLoginScreen}"/>
            <views:WelcomeView IsVisible="{Binding IsWelcomeScreen}"/>

            <Panel IsVisible="{Binding ShowDesktopLayout}">
                <views:DesktopView DataContext="{Binding Desktop}"/>
            </Panel>
            <Panel IsVisible="{Binding ShowMobileLayout}">
                <views:MobileHomeView DataContext="{Binding Desktop}"/>
            </Panel>
        </Panel>
    </Grid>
</UserControl>
