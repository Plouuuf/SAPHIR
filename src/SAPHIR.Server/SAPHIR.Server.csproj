<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Serveur SAPHIR : connexion Discord par rôle, temps réel (WebSocket), socle (agents, profils, permissions,
    paramètres, historique, journal des accès) dans MariaDB avec migrations numérotées.
    Lancement local : voir README.md.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>SAPHIR.Server</AssemblyName>
    <RootNamespace>Saphir.Server</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- MariaDB : base SAPHIR. -->
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SAPHIR.Shared\SAPHIR.Shared.csproj" />
  </ItemGroup>
</Project>
