<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Serveur SAPHIR : connexion Discord par rôle, temps réel (WebSocket) et données métier
    (MEO-FIC : TAJ, FPR, SNPC, FOVeS, SIV, FVA) dans MariaDB, avec lecture de la base FiveM.
    Lancement local : voir README.md.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>SAPHIR.Server</AssemblyName>
    <RootNamespace>Saphir.Server</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- MariaDB : base SAPHIR et lecture de la base FiveM. -->
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SAPHIR.Shared\SAPHIR.Shared.csproj" />
  </ItemGroup>
</Project>
